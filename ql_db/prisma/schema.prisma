generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model laptops {
  id            String  @id @db.VarChar(50)
  name          String  @db.VarChar(100)
  usage         String  @db.VarChar(20)
  price         Int
  cpu           String  @db.VarChar(50)
  gpu           String? @db.VarChar(50)
  screen        Decimal @db.Decimal(4, 1)
  screen_name   String  @db.VarChar(50)
  battery       Int
  storage       String  @db.VarChar(20)
  ram           String  @db.VarChar(20)
  design        String  @db.VarChar(20)
  build_quality String  @db.VarChar(20)
  performance   String  @db.VarChar(20)
}
